# HuggingFace API token (get from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# --- GraphRAG++ Fine-Tuned Model Config ---
# Model ID: your-username/graphrag-plus-plus-qwen35-4b
HF_MODEL_ID=Jackrong/Qwen3.5-4B-Claude-4.6-Opus-Reasoning-Distilled-v2

# --- Deployment Endpoints ---
# Modal / Cloud Run (Remote GPU)
CLOUD_RUN_URL=

# Local Llama.cpp Server (Local AMD GPU via Vulkan)
# Start with: llama-server -m ./model.gguf --port 8080
LOCAL_LLAMA_CPP_URL=http://localhost:8080

# --- Engine Settings ---
USE_SIMULATION=false
EMBED_MODEL=all-MiniLM-L6-v2
NEXT_PUBLIC_API_URL=http://localhost:8000
